{
    "elements": [
        {
            "type": "SelectInstance",
            "name": "ArchiveID",
            "caption": "Archiv (leer = Standardarchiv)"
        },
        {
            "type": "List",
            "name": "Meters",
            "caption": "Zähler",
            "rowCount": 12,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "200px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Gruppe",
                    "name": "Group",
                    "width": "150px",
                    "add": "consumer",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Hauptzähler",
                                "value": "main"
                            },
                            {
                                "caption": "Verbraucher",
                                "value": "consumer"
                            }
                        ]
                    }
                },
                {
                    "caption": "Quelle",
                    "name": "Source",
                    "width": "150px",
                    "add": "counter",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Zählerstand",
                                "value": "counter"
                            },
                            {
                                "caption": "Impulse",
                                "value": "impulse"
                            }
                        ]
                    }
                },
                {
                    "caption": "Einheit (Zählerstand)",
                    "name": "Unit",
                    "width": "140px",
                    "add": "kWh",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "kWh",
                                "value": "kWh"
                            },
                            {
                                "caption": "Wh",
                                "value": "Wh"
                            }
                        ]
                    }
                },
                {
                    "caption": "Impulse pro kWh",
                    "name": "Impulses",
                    "width": "130px",
                    "add": 1000,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 1
                    }
                },
                {
                    "caption": "Überlauf bei",
                    "name": "Overflow",
                    "width": "120px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 0
                    }
                },
                {
                    "caption": "Aktiv",
                    "name": "Active",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Die Variablen müssen im Archiv geloggt sein, am besten als „Zähler“. Bei „Standard“ wird der Verbrauch aus den Zählerständen berechnet. „Überlauf bei“: Wert, bei dem der Zähler wieder bei 0 beginnt (z. B. 65536), 0 = Zähler wird nur zurückgesetzt."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Anzeige und Prognose",
            "items": [
                {
                    "type": "Select",
                    "name": "DefaultPeriod",
                    "caption": "Standard-Zeitraum",
                    "options": [
                        {
                            "caption": "Stunde",
                            "value": "hour"
                        },
                        {
                            "caption": "Tag",
                            "value": "day"
                        },
                        {
                            "caption": "Woche",
                            "value": "week"
                        },
                        {
                            "caption": "Jahr",
                            "value": "year"
                        },
                        {
                            "caption": "Eigener Zeitraum",
                            "value": "custom"
                        }
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CustomStart",
                    "caption": "Eigener Zeitraum Start (Vorgabe)",
                    "placeholder": "2026-01-01 00:00"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "CustomEnd",
                    "caption": "Eigener Zeitraum Ende (Vorgabe)",
                    "placeholder": "2026-12-31 23:59"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ForecastDays",
                    "caption": "Prognose für",
                    "suffix": "Tage",
                    "minimum": 1,
                    "maximum": 365
                },
                {
                    "type": "NumberSpinner",
                    "name": "HistoryDays",
                    "caption": "Basis der Prognose",
                    "suffix": "Tage",
                    "minimum": 7,
                    "maximum": 1095
                },
                {
                    "type": "NumberSpinner",
                    "name": "UpdateInterval",
                    "caption": "Automatisch aktualisieren alle",
                    "suffix": "Minuten (0 = aus)",
                    "minimum": 0,
                    "maximum": 1440
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Jetzt aktualisieren",
            "onClick": "ECV_Refresh($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Instanz ist aktiv"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Kein Archiv gefunden"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Mindestens ein Zähler fehlt oder wird nicht archiviert (Details im Debug)"
        }
    ]
}